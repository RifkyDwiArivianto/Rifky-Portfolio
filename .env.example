# Salin ke .env.local untuk dev lokal. Di Vercel, isi lewat Settings → Environment Variables.
# JANGAN commit berkas .env.local. Jangan beri awalan NEXT_PUBLIC_ pada nilai-nilai ini.

# Supabase → Project Settings → API
# Integrasi Vercel membuat variabel ini otomatis. Kunci server bisa bernama SUPABASE_SECRET_KEY
# (kunci baru, sb_secret_...) atau SUPABASE_SERVICE_ROLE_KEY (lama); salah satu cukup.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Kata sandi masuk /admin (minimal 8 karakter, makin panjang makin baik)
ADMIN_PASSWORD=

# Rahasia penanda tangan cookie sesi (minimal 16 karakter, acak). Contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
